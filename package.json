{
  "name": "@yogawithethan/iinb-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "npm --prefix apps/web run build",
    "dev:web": "npm --prefix apps/web run dev",
    "lint:web": "npm --prefix apps/web run lint",
    "build:native-content": "npm --prefix apps/native run build:chapters",
    "dev:native": "npm --prefix apps/native run start",
    "lint:native": "npm --prefix apps/native run lint",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:ecosystem": "node scripts/verify-ecosystem-contract.mjs",
    "verify": "npm run verify:content && npm run verify:ecosystem && npm run build:native-content && npm run lint:web && npm run lint:native && npm run build:web"
  }
}
